rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Strict personal tenant isolation
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Multi-tenant laboratory isolation
    match /labs/{labId}/{document=**} {
      allow read, write: if request.auth != null && (
        resource == null || 
        request.auth.uid in resource.data.memberIds || 
        request.auth.uid == resource.data.ownerId
      );
    }

    // 3. Shared wet-lab bench collections (strictly authenticated)
    match /reagents/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /organizations/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /experiments/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /plates/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /equipment_bookings/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /audit_trail/{document=**} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    match /terms_acceptance_logs/{document=**} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow update, delete: if false;
    }

    match /dsar_requests/{document=**} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow update, delete: if false;
    }

    // Deny all unauthenticated or unmatched access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
